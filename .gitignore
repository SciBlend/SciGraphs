# city2graph/

# Test databases (local testing only)
test_databases/
paper_scigraphs/*
images_ignore/*
examples/*
/.quarto/
**/*.quarto_ipynb

# Golden-image renders. The manifest under tests/golden/baseline/ IS committed --
# it carries the fingerprints and tolerances, so a checkout can verify without
# these. The PNGs are 32 MB and only exist to be looked at.
tests/golden/_out/

# Browser renderer test fixtures: 229 MB, of which one 1M-node payload is 212 MB.
# Regenerable with web/static/render/dev/make_fixtures.py.
web/*

# Private engine history
.git-private/

# API keys and other secrets. The OpenTopography key lives in Blender's add-on
# preferences (~/.config), or in OPENTOPOGRAPHY_API_KEY — never in the tree.
*.key
.env
.secrets
secrets.*
**/api_keys.json

# Quarto build artefacts inside the embedded-notebook folder, and the copies
# themselves: both are derived from notebooks/*.ipynb by the docs build.
docs/notebooks/_ipynb/
